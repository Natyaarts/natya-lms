# ==============================================================================
# Elastic Beanstalk Configuration for Celery Worker & Celery Beat Services
# Environment: Amazon Linux 2 / Amazon Linux 2023 (Python 3.14 compatible)
# ==============================================================================

files:
  "/etc/systemd/system/celery-worker.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Celery Worker Service for Natya LMS
      After=network.target

      [Service]
      Type=simple
      User=webapp
      Group=webapp
      WorkingDirectory=/var/app/current
      EnvironmentFile=/opt/elasticbeanstalk/deployment/env
      ExecStart=/bin/sh -c 'source /var/app/venv/*/bin/activate && exec celery -A core worker -l info --concurrency=1 --max-memory-per-child=250000 --logfile=/var/log/celery/worker.log'
      Restart=always
      RestartSec=10
      KillMode=mixed
      TimeoutStopSec=10

      [Install]
      WantedBy=multi-user.target

  "/etc/systemd/system/celery-beat.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Celery Beat Scheduler Service for Natya LMS
      After=network.target

      [Service]
      Type=simple
      User=webapp
      Group=webapp
      WorkingDirectory=/var/app/current
      EnvironmentFile=/opt/elasticbeanstalk/deployment/env
      ExecStartPre=/bin/sh -c 'rm -f /var/run/celery/beat.pid'
      ExecStart=/bin/sh -c 'source /var/app/venv/*/bin/activate && exec celery -A core beat -l info --pidfile=/var/run/celery/beat.pid --schedule=/var/run/celery/celerybeat-schedule --logfile=/var/log/celery/beat.log'
      Restart=always
      RestartSec=10
      KillMode=mixed
      TimeoutStopSec=30

      [Install]
      WantedBy=multi-user.target

commands:
  00_prepare_memory_and_stop_celery:
    command: |
      if ! swapon --show 2>/dev/null | grep -q '/var/swapfile'; then
        if [ ! -f /var/swapfile ]; then
          dd if=/dev/zero of=/var/swapfile bs=1M count=2048 status=none 2>/dev/null || true
          chmod 600 /var/swapfile 2>/dev/null || true
          mkswap /var/swapfile 2>/dev/null || true
        fi
        swapon /var/swapfile 2>/dev/null || true
      fi
      systemctl stop --no-block celery-worker.service celery-beat.service 2>/dev/null || true
  01_create_celery_dirs:
    command: "mkdir -p /var/log/celery /var/run/celery && chown -R webapp:webapp /var/log/celery /var/run/celery && chmod 755 /var/log/celery /var/run/celery"

container_commands:
  01_chmod_postdeploy_hooks:
    command: "chmod +x .platform/hooks/postdeploy/*.sh 2>/dev/null || true"
